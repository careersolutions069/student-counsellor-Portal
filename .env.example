NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:59321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STUDENT_SESSION_SECRET=
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000
# Set only to the single IP header overwritten by your trusted deployment proxy.
# With no header configured all requests share one IP rate-limit bucket.
TRUSTED_IP_HEADER=
# Company calling provider for branches with company calling on. Leave empty until a provider is chosen.
# "fake" is a local test provider that never dials; it is ignored on Vercel production.
CALL_PROVIDER=
# Secret used to verify provider webhooks at /api/calls/webhook/<provider>.
CALL_WEBHOOK_SECRET=
